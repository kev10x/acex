# Copy to .env and fill in your values
# cp env.example .env

# Database (MySQL / MariaDB)
# DATABASE_URL=mysql://user:password@localhost:3306/markmate

# Server
PORT=3001
NODE_ENV=development

# JWT for auth (use a long random string in production)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Frontend URL – used in verification and password-reset email links (no trailing slash)
# Production: set to your app URL, e.g. https://markmate.io/tools
CLIENT_URL=http://localhost:3000
# API base path for server-returned URLs (e.g. feedback video). Set in production if app is under a path, e.g. API_PUBLIC_BASE=/tools/api
# API_PUBLIC_BASE=/tools/api
# Path prefix when the reverse proxy forwards the full URL (e.g. /tools). Set BASE_PATH=/tools so /tools/api/* is served. Required for https://markmate.io/tools/api/...
# BASE_PATH=/tools
# BASE_URL=http://localhost:3000

# --- Gmail (verification & registration emails) ---
# Use your Gmail address and an App Password (not your normal password).
# 1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password



# Optional: custom "From" name/address (defaults to GMAIL_USER)
# SMTP_FROM=MarkMate <yourname@gmail.com>

# --- Alternative: generic SMTP (instead of Gmail) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# AI (for marking, rubric generator, etc.)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=openai
# Marking prompt text limits. PDF extraction stores full text; these only cap how much text is sent to AI.
# Defaults: assignments/reports/question papers/default 60000, memo 80000, treatise 800000.
# MARKING_ASSIGNMENT_MAX_CHARS=60000
# MARKING_REPORT_MAX_CHARS=60000
# MARKING_QUESTION_PAPER_MAX_CHARS=60000
# MARKING_MEMO_MAX_CHARS=80000
# MARKING_TREATISE_MAX_CHARS=800000
# MARKING_DEFAULT_MAX_CHARS=60000
# Only used for quick document-type classification, not marking.
# DOCUMENT_TYPE_DETECTION_PREVIEW_CHARS=6000
# When PDF text extraction fails or returns too little text, Vision AI is used as fallback (scanned/handwritten PDFs).
# Vision uses your OpenAI usage quota; if you see 429/quota errors, add credits at https://platform.openai.com/account/billing
# Set to false to disable: ENABLE_VISION_API=false
# Feedback video (Sora): model for video explaining marking feedback (sora-2 or sora-2-pro)
# SORA_MODEL=sora-2
# Duration in seconds for single-clip mode (allowed: 4, 8, 12). Default 8.
# SORA_VIDEO_SECONDS=8
# Multi-clip mode: number of short clips to generate and stitch (1-5). Default 1. Requires ffmpeg on the server.
# SORA_VIDEO_CLIPS=3
# Seconds per clip when SORA_VIDEO_CLIPS > 1 (allowed: 4, 8, 12). Total length = SORA_VIDEO_CLIPS x this.
# SORA_VIDEO_SECONDS_PER_CLIP=4
# Optional overrides for Content Generator videos specifically.
# SORA_CONTENT_VIDEO_CLIPS=5
# SORA_CONTENT_VIDEO_SECONDS_PER_CLIP=12

# Content generation resilience tuning
# CONTENT_MAX_SECTIONS=120
# CONTENT_RESILIENT_CHUNK_SIZE=8
# CONTENT_RESILIENT_CHUNK_THRESHOLD=18
# CONTENT_RESILIENT_CHUNK_MAX_RETRIES=3
# CONTENT_RESILIENT_INTER_BATCH_DELAY_MS=700
# CONTENT_IMAGE_RETRIES=3
# CONTENT_IMAGE_RETRY_DELAY_MS=450
# CONTENT_PLANNER_CONCURRENCY=1
# CONTENT_TEXT_BEAUTIFY_MODEL=gpt-4o-mini
# CONTENT_TEXT_BEAUTIFY_MAX_TOKENS=1400
# CONTENT_TEXT_BEAUTIFY_CONCURRENCY=2
# PPTX export resilience (default is strict provider export, no fallback)
# Set timeout (ms) only if you want provider export to fail fast. 0 disables timeout.
# CONTENT_EXPORT_PPTX_PROVIDER_TIMEOUT_MS=0
# CONTENT_EXPORT_PPTX_FORCE_LOCAL=0
# CONTENT_EXPORT_PPTX_ALLOW_FALLBACK=0

# Upload limits
# MAX_FILE_SIZE=10MB
# MAX_ZIP_SIZE=100MB
# UPLOAD_DIR=./uploads

# Optional: PDF→image uses ImageMagick + Ghostscript. If binaries not found (e.g. PM2/Virtualmin), set:
# GHOSTSCRIPT_PATH=/usr/bin/gs
# IMAGEMAGICK_PATH=/usr/bin   (directory containing the "convert" binary, or full path to convert)

