{
  "name": "acexen",
  "version": "1.0.0",
  "description": "Acexen — AI-powered academic marking and excellence engine",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "deploy:annotation-video": "node scripts/deploy-annotation-video-feedback.js",
    "test:server": "node --test --test-concurrency=1 --test-isolation=none server/**/*.test.js",
    "setup": "node setup.js && npm install && cd client && npm install",
    "demo": "node demo-data.js",
    "seed:sample-org": "node seed-sample-organisation.js",
    "seed:ntp3011": "node scripts/seed-ntp3011-rubric.js",
    "postinstall": "node setup.js",
    "reparse:failed": "node scripts/reparse-failed.js",
    "test:decode-payload": "node scripts/test-decode-payload.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.19.1",
    "nodemailer": "^8.0.4",
    "openai": "^4.20.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^2.2.4",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pptxgenjs": "^3.12.0",
    "uuid": "^9.0.1",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "keywords": [
    "pdf",
    "marking",
    "ai",
    "education",
    "assignment"
  ],
  "author": "Acexen Team",
  "license": "MIT"
}
