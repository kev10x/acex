{
  "name": "markmate",
  "version": "1.0.0",
  "description": "AI-powered PDF assignment marking application",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "setup": "node setup.js && npm install && cd client && npm install",
    "demo": "node demo-data.js",
    "postinstall": "node setup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.19.1",
    "nodemailer": "^6.10.1",
    "openai": "^4.20.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^2.2.4",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.17.2",
    "pg": "^8.20.0",
    "pptxgenjs": "^3.12.0",
    "uuid": "^9.0.1",
    "yauzl": "^3.2.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.14"
  },
  "keywords": [
    "pdf",
    "marking",
    "ai",
    "education",
    "assignment"
  ],
  "author": "MarkMate Team",
  "license": "MIT"
}
